{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "blocked-ip-range.schema.json",
    "title": "Blocked IP range",
    "description": "A list of IP ranges that should be blocked.",
    "type": "object",
    "properties": {
        "name": {
            "description": "The name of the range.",
            "type": "string"
        },
        "reason": {
            "description": "A reason for the block.",
            "type": "string"
        },
        "ipRanges": {
            "description": "The CIDR ranges to block.",
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "name",
        "reason"
    ]
}
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Merge IP ranges to data file",
            "detail": "Merges all IP ranges into the data file.",
            "icon": {
                "id": "merge",
                "color": "terminal.ansiGreen"
            },
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/scripts/Merge-BlockedIpRanges.ps1",
            "args": [
                "-RootDirectory",
                "${workspaceFolder}",
                "-CreateCommit:$${input:createCommit}",
                "-Verbose"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "pwsh",
                    "args": [
                        "-NoLogo",
                        "-NoProfile",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }
    ],
    "inputs": [
        {
            "id": "createCommit",
            "description": "Create a commit of the changes?",
            "type": "pickString",
            "default": "false",
            "options": [
                {
                    "label": "Yes",
                    "value": "true"
                },
                {
                    "label": "No",
                    "value": "false"
                }
            ]
        }
    ]
}
